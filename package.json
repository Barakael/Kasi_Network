{
  "name": "kasi-network",
  "private": true,
  "description": "Multi-tenant MikroTik hotspot billing platform",
  "scripts": {
    "dev:portal": "pnpm --filter @kasi/portal dev",
    "dev:console": "pnpm --filter @kasi/console dev",
    "build": "pnpm --filter @kasi/portal build && pnpm --filter @kasi/console build",
    "typecheck": "pnpm --filter @kasi/portal typecheck && pnpm --filter @kasi/console typecheck",
    "lint": "pnpm --filter @kasi/portal lint && pnpm --filter @kasi/console lint"
  },
  "packageManager": "pnpm@10.22.0"
}
