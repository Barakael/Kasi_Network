APP_NAME="Kasi Network"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kasi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=kasi

# Use "phpredis" when the PHP extension is installed; "predis" needs no extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@kasi.network"
MAIL_FROM_NAME="${APP_NAME}"

# --- Kasi Network: interfaces ---
# Origins of the captive portal and operator console. Used for CORS and for the
# QR redemption links printed on voucher cards.
PORTAL_URL=http://localhost:5173
CONSOLE_URL=http://localhost:5174

# --- Kasi Network: vouchers ---
# Keys the HMAC that voucher codes are found by. Generate with:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Changing this orphans every existing code_hash, so it cannot be rotated without
# re-hashing the vouchers table. Falls back to APP_KEY when unset.
KASI_VOUCHER_HASH_KEY=

# --- Kasi Network: RADIUS ---
# Public IP (preferred) or host the MikroTik sends Access-Requests to.
# Do not use the portal hostname: hotspot DNS is hijacked.
RADIUS_PUBLIC_HOST=161.97.182.204
# RouterOS only accepts CoA/Disconnect once `/radius incoming set accept=yes`.
RADIUS_COA_PORT=3799
RADIUS_RADCLIENT_BIN=radclient
# Must match each router's `radius-mac-format`, or MAC authentication for
# voucher-bound devices stops matching without any error.
RADIUS_MAC_FORMAT=XX:XX:XX:XX:XX:XX
# Restricted MySQL account FreeRADIUS connects as. Applied by
# `php artisan kasi:provision-radius-user`.
RADIUS_DB_USER=radius
RADIUS_DB_PASSWORD=radius_secret

# --- Kasi Network: Snippe payments ---
# Live credentials are stored encrypted per tenant; these are development
# fallbacks. Keys are prefixed snp_.
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_BASE_URL=https://api.snippe.sh/v1
SNIPPE_RATE_LIMIT_PER_MINUTE=60

# --- Kasi Network: PalmPesa payments ---
# Live token is stored encrypted per tenant; these are the single-operator
# fallbacks for this VPS. Never commit a real token. Initiate is token-only;
# user id / vendor are kept for optional pay-via-mobile later.
PALMPESA_BASE_URL=https://palmpesa.drmlelwa.co.tz
PALMPESA_API_TOKEN=
PALMPESA_USER_ID=
PALMPESA_VENDOR=TILL61103867
PALMPESA_ADDRESS="Dar es Salaam"
PALMPESA_POSTCODE=11111
PALMPESA_CUSTOMER_EMAIL=hotspot@wayda.co.tz

# Give away portal vouchers without payment. Must be false in production.
KASI_PORTAL_DEMO_CHECKOUT=false

VITE_APP_NAME="${APP_NAME}"
