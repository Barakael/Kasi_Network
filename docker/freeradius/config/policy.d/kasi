# -*- text -*-
#
# Normalise Calling-Station-Id to AA:BB:CC:DD:EE:FF before radcheck CSI locks
# and MAC binding run. RouterOS sometimes sends lowercase; radcheck stores
# uppercase, and `==` is case-sensitive.

normalize_calling_station_id {
	if (Calling-Station-Id =~ /^([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})$/) {
		update request {
			&Calling-Station-Id := "%{toupper:%{1}:%{2}:%{3}:%{4}:%{5}:%{6}}"
		}
	}
}

# Rewrites a MAC username (RouterOS radius-mac-authentication) onto the parent
# voucher code so accounting and sqlcounter share one quota. Scoped by the NAS
# the request arrived on, so the same physical device on two operators' networks
# does not collide.

rewrite_mac_username {
	if (User-Name =~ /^([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})[-:.]?([0-9a-fA-F]{2})$/) {
		update request {
			&Tmp-String-0 := "%{tolower:%{1}:%{2}:%{3}:%{4}:%{5}:%{6}}"
		}
		update request {
			&Tmp-String-0 := "%{toupper:%{Tmp-String-0}}"
		}

		if ("%{sql:SELECT vu.username FROM voucher_devices vd INNER JOIN voucher_usage vu ON vu.voucher_id = vd.voucher_id INNER JOIN nas_devices nd ON nd.tenant_id = vd.tenant_id INNER JOIN sites s ON s.id = nd.site_id WHERE vd.mac = '%{Tmp-String-0}' AND vd.status = 'active' AND nd.deleted_at IS NULL AND (nd.nasname = '%{Packet-Src-IP-Address}' OR nd.nasname = '%{NAS-IP-Address}' OR nd.api_host = '%{NAS-IP-Address}' OR (s.nas_identifier = '%{NAS-Identifier}' AND '%{NAS-Identifier}' != '')) LIMIT 1}" != "") {
			# MikroTik MAC-auth sends User-Name=MAC and Password=MAC (or empty).
			# After rewriting User-Name onto the voucher code, the password must
			# become that same code or PAP/CHAP fails against Cleartext-Password.
			update request {
				&Stripped-User-Name := "%{User-Name}"
				&User-Name := "%{sql:SELECT vu.username FROM voucher_devices vd INNER JOIN voucher_usage vu ON vu.voucher_id = vd.voucher_id INNER JOIN nas_devices nd ON nd.tenant_id = vd.tenant_id INNER JOIN sites s ON s.id = nd.site_id WHERE vd.mac = '%{Tmp-String-0}' AND vd.status = 'active' AND nd.deleted_at IS NULL AND (nd.nasname = '%{Packet-Src-IP-Address}' OR nd.nasname = '%{NAS-IP-Address}' OR nd.api_host = '%{NAS-IP-Address}' OR (s.nas_identifier = '%{NAS-Identifier}' AND '%{NAS-Identifier}' != '')) LIMIT 1}"
			}
			update request {
				&User-Password := "%{User-Name}"
			}
			update control {
				&Cleartext-Password := "%{User-Name}"
				&Auth-Type := PAP
			}
		}
		else {
			update reply {
				Reply-Message := "Device is not bound to a voucher"
			}
			reject
		}
	}
}
